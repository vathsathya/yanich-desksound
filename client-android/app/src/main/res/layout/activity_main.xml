<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Scrollable Main Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavContainer"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ================================================================ -->
            <!-- HEADER: Logo, Subtitle & Compact Streaming Status Pill           -->
            <!-- ================================================================ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DeskSound"
                        android:textColor="@color/text_primary"
                        android:textSize="26sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold"
                        android:singleLine="true"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <!-- Status Pill Badge -->
                <LinearLayout
                    android:id="@+id/layoutStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_card_unselected"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">

                    <View
                        android:id="@+id/statusDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/custom_progress_bar"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="STREAMING"
                        android:textColor="@color/status_connected"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:singleLine="true"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:letterSpacing="0.04" />
                </LinearLayout>
            </LinearLayout>

            <!-- Update Available Banner (Hidden by default) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/layoutUpdateBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/primary">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvUpdateTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Update Available"
                            android:textColor="@color/primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvUpdateDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="New performance &amp; audio synchronization fixes"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUpdateNow"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Update"
                        android:textColor="@color/bg_dark"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        app:backgroundTint="@color/primary"
                        app:cornerRadius="10dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ================================================================ -->
            <!-- TAB 1 VIEW: CONNECT SCREEN                                       -->
            <!-- ================================================================ -->
            <LinearLayout
                android:id="@+id/layoutTabConnection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- 1. Wi-Fi & USB Selectable Mode Cards -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <!-- Wi-Fi Mode Card (Left) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnModeWifi"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="75dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:padding="8dp"
                        android:gravity="center"
                        android:text="Wi-Fi Mode"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        app:icon="@drawable/ic_wifi_vector"
                        app:iconGravity="top"
                        app:iconSize="22dp"
                        app:iconTint="@color/primary"
                        app:iconPadding="6dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:strokeColor="@color/primary"
                        app:strokeWidth="2dp"
                        app:backgroundTint="@color/card"
                        app:cornerRadius="14dp" />

                    <!-- USB Mode Card (Right) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnModeUsb"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="75dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:padding="8dp"
                        android:gravity="center"
                        android:text="USB Mode"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="false"
                        app:icon="@drawable/ic_usb_vector"
                        app:iconGravity="top"
                        app:iconSize="22dp"
                        app:iconTint="@color/text_secondary"
                        app:iconPadding="6dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:strokeColor="@color/border_muted"
                        app:strokeWidth="1dp"
                        app:backgroundTint="@color/surface"
                        app:cornerRadius="14dp" />
                </LinearLayout>

                <!-- Modern Mode Info Helper Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border_muted">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/tvModeTip"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Wi-Fi Mode active (Normal local network streaming)"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:lineSpacingExtra="2dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 2. Configuration & Connection Settings Section Container -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Server IP Section (Dynamically hidden in USB Mode) -->
                    <LinearLayout
                        android:id="@+id/layoutServerIpSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Client IP Address Display -->
                        <LinearLayout
                            android:id="@+id/layoutClientIpSection"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginBottom="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Client IP Address"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textAllCaps="true"
                                android:letterSpacing="0.05"
                                android:layout_marginBottom="8dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="50dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:background="@drawable/bg_card_unselected"
                                android:paddingHorizontal="16dp">

                                <TextView
                                    android:id="@+id/tvClientIp"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="192.168.1.100"
                                    android:textColor="@color/accent_cyan"
                                    android:textSize="15sp"
                                    android:fontFamily="sans-serif-medium" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Target Server Address"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textAllCaps="true"
                            android:letterSpacing="0.05"
                            android:layout_marginBottom="8dp" />

                        <!-- Rounded IP Input with Integrated Cyan SCAN Button -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_card_unselected"
                            android:paddingHorizontal="16dp"
                            android:layout_marginBottom="16dp">

                            <EditText
                                android:id="@+id/etServerIp"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@null"
                                android:hint="IP Address (e.g., 192.168.1.5)"
                                android:inputType="text"
                                android:text="192.168.1.100"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_disabled"
                                android:textSize="14sp"
                                android:fontFamily="sans-serif-medium" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnScanServer"
                                android:layout_width="wrap_content"
                                android:layout_height="38dp"
                                android:paddingHorizontal="16dp"
                                android:text="SCAN"
                                android:textColor="#080D1A"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                app:cornerRadius="19dp"
                                app:backgroundTint="@color/primary" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Audio Output Configuration"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textAllCaps="true"
                        android:letterSpacing="0.05"
                        android:layout_marginBottom="8dp" />

                    <!-- Modern Audio Route Dropdown Selector -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        app:cardBackgroundColor="@color/surface"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/border_muted">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp">

                            <TextView
                                android:id="@+id/tvHeadphoneRoute"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Audio Route: Phone Speaker Output"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="▾"
                                android:textColor="@color/text_secondary"
                                android:textSize="16sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- 3. Primary Action Button (START STREAMING) - Placed at the bottom of configurations -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConnect"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="24dp"
                    android:text="START STREAMING"
                    android:textColor="#080D1A"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.04"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="27dp"
                    app:backgroundTint="@color/primary"
                    app:elevation="4dp" />

                <EditText
                    android:id="@+id/etServerPort"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone"
                    android:text="5000" />

            </LinearLayout>

            <!-- ================================================================ -->
            <!-- TAB 2 VIEW: MONITOR SCREEN (AUDIO SPECTRUM & CONTROLS)            -->
            <!-- ================================================================ -->
            <LinearLayout
                android:id="@+id/layoutTabMonitor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Unified Master Audio Control Hub Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border_muted">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Top Title & Mode Badge -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="16dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Live Audio Monitor"
                                android:textColor="@color/text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvChannelMode"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Stereo (L+R)"
                                android:textColor="@color/primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- 7-Band Vertical Cyan Equalizer Visualizer Spectrum -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="125dp"
                            android:orientation="horizontal"
                            android:gravity="bottom|center_horizontal"
                            android:layout_marginBottom="24dp">

                            <View
                                android:id="@+id/barEq1"
                                android:layout_width="18dp"
                                android:layout_height="24dp"
                                android:layout_marginHorizontal="6dp"
                                android:background="@drawable/bg_spectrum_bar" />

                            <View
                                android:id="@+id/barEq2"
                                android:layout_width="18dp"
                                android:layout_height="48dp"
                                android:layout_marginHorizontal="6dp"
                                android:background="@drawable/bg_spectrum_bar" />

                            <View
                                android:id="@+id/barEq3"
                                android:layout_width="18dp"
                                android:layout_height="76dp"
                                android:layout_marginHorizontal="6dp"
                                android:background="@drawable/bg_spectrum_bar" />

                            <View
                                android:id="@+id/barEq4"
                                android:layout_width="18dp"
                                android:layout_height="104dp"
                                android:layout_marginHorizontal="6dp"
                                android:background="@drawable/bg_spectrum_bar" />

                            <View
                                android:id="@+id/barEq5"
                                android:layout_width="18dp"
                                android:layout_height="64dp"
                                android:layout_marginHorizontal="6dp"
                                android:background="@drawable/bg_spectrum_bar" />

                            <View
                                android:id="@+id/barEq6"
                                android:layout_width="18dp"
                                android:layout_height="40dp"
                                android:layout_marginHorizontal="6dp"
                                android:background="@drawable/bg_spectrum_bar" />

                            <View
                                android:id="@+id/barEq7"
                                android:layout_width="18dp"
                                android:layout_height="20dp"
                                android:layout_marginHorizontal="6dp"
                                android:background="@drawable/bg_spectrum_bar" />
                        </LinearLayout>

                        <!-- Volume Output Section -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Volume Output"
                                android:textColor="@color/text_secondary"
                                android:textSize="14sp"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:id="@+id/tvVolumeVal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="100%"
                                android:textColor="@color/primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderVolume"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:valueFrom="0.0"
                            android:valueTo="1.0"
                            android:value="1.0"
                            app:thumbColor="@color/primary"
                            app:trackColorActive="@color/primary"
                            app:trackColorInactive="@color/card"
                            android:layout_marginBottom="20dp" />

                        <!-- Subtle Divider Line -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/border_muted"
                            android:layout_marginBottom="20dp" />

                        <!-- Channel Mode Selection Segment -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Channel Mode Override"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="12dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="20dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnChannelAuto"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="46dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="4dp"
                                android:text="AUTO"
                                android:textColor="@color/primary"
                                android:textSize="12sp"
                                android:paddingHorizontal="2dp"
                                android:paddingVertical="0dp"
                                android:includeFontPadding="false"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                app:strokeColor="@color/primary"
                                app:cornerRadius="23dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnChannelLeft"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="46dp"
                                android:layout_weight="1"
                                android:layout_marginHorizontal="4dp"
                                android:text="LEFT"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:paddingHorizontal="2dp"
                                android:paddingVertical="0dp"
                                android:includeFontPadding="false"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                app:strokeColor="@color/border_muted"
                                app:cornerRadius="23dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnChannelRight"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="46dp"
                                android:layout_weight="1"
                                android:layout_marginStart="4dp"
                                android:text="RIGHT"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:paddingHorizontal="2dp"
                                android:paddingVertical="0dp"
                                android:includeFontPadding="false"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                app:strokeColor="@color/border_muted"
                                app:cornerRadius="23dp" />
                        </LinearLayout>

                        <!-- Subtle Divider Line -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/border_muted"
                            android:layout_marginBottom="16dp" />

                        <!-- Speaker Audio DSP Optimization Inline Segment -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Speaker Audio DSP Noise-Gate"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                app:thumbTint="@color/primary"
                                app:trackTint="@color/card_elevated" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- ================================================================ -->
            <!-- TAB 3 VIEW: INFO & SOFTWARE UPDATE SCREEN                        -->
            <!-- ================================================================ -->
            <LinearLayout
                android:id="@+id/layoutTabInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Application Purpose Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border_muted">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@mipmap/ic_launcher"
                                android:layout_marginEnd="12dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="DeskSound Mobile"
                                    android:textColor="@color/text_primary"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvInfoAppVersion"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Version 1.0.3 • Real-Time Audio Receiver"
                                    android:textColor="@color/primary"
                                    android:textSize="12sp"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="គោលបំណងកម្មវិធី (App Purpose):"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="DeskSound គឺជាកម្មវិធីទទួលសំឡេងទូរស័ព្ទដៃ Real-time ដែលផ្ដល់នូវគុណភាពសំឡេងខ្ពស់ និង Latency ទាបបំផុត (Low-latency Audio Receiver)។ វាអនុញ្ញាតឱ្យលោកអ្នកបញ្ជូនសំឡេងពីកុំព្យូទ័រ (PC) មកកាន់ទូរស័ព្ទដៃតាមរយៈបណ្តាញ Wi-Fi ឬ USB Tethering យ៉ាងរលូន។\n\nDeskSound is a high-performance, real-time wireless and USB audio streaming receiver. It allows your Android device to receive high-fidelity, low-latency audio from your PC seamlessly."
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:lineSpacingExtra="3dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Developer / Author Information Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border_muted">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="អ្នកបង្កើត (Developer)"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="12dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Vath Sathya (@vathsathya)"
                                android:textColor="@color/primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="GitHub Release"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Check For Update Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border_muted">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Software Update (បច្ចុប្បន្នភាព)"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/tvUpdateStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="ចុចប៊ូតុងខាងក្រោមដើម្បីពិនិត្យមើល Version ថ្មីពី GitHub Repository Release"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:layout_marginBottom="16dp" />

                        <ProgressBar
                            android:id="@+id/progressBarUpdate"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            android:indeterminate="true"
                            android:layout_marginBottom="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCheckUpdateInfo"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:text="CHECK FOR UPDATE"
                            android:textColor="#080D1A"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.04"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            app:cornerRadius="25dp"
                            app:backgroundTint="@color/primary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ================================================================ -->
    <!-- FIXED 3-TAB BOTTOM NAVIGATION BAR (Connect / Monitor / Info)     -->
    <!-- ================================================================ -->
    <LinearLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="@color/nav_bar_bg"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical">

        <!-- Tab 1: Connect -->
        <LinearLayout
            android:id="@+id/btnTabConnection"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/imgNavConnection"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_connect_nav"
                app:tint="@color/primary" />

            <TextView
                android:id="@+id/tvNavConnection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connect"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <!-- Tab 2: Monitor -->
        <LinearLayout
            android:id="@+id/btnTabMonitor"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/imgNavMonitor"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_monitor_nav"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/tvNavMonitor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Monitor"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <!-- Tab 3: Info -->
        <LinearLayout
            android:id="@+id/btnTabInfo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/imgNavInfo"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_info_nav"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/tvNavInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Info"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="3dp" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
